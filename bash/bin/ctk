#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/../scripts" && pwd)"

main() {

    local mode="${1:-}"

    if [[ "$mode" == "cmds" ]]
    then
        printf '%s\n' $(list)
        exit 0
    fi

    for script in "$SCRIPT_DIR"/*.sh
    do
        if match_mode "$script" "$mode"
        then
            exec "$script" "$@"
            break
        fi
    done
    fuzzy_mode
}

match_mode() {
    local script="$1"
    local mode="$2"
    "$script" modelist | grep -qx "$mode"
}

fuzzy_mode() {
    local mode
    mode="$(list | fzf)"
    [[ -z "$mode" ]] && return 0
    exec "$0" "$mode"

}

list() {
    for script in "$SCRIPT_DIR"/*.sh
    do
        "$script" modelist
    done | /usr/bin/sort -u
}

main "$@"
